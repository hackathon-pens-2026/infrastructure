# ==========================================
# .NET 8 Backend Environment Variables
# ==========================================

# ASP.NET Core Settings
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
PORT=8080

# Database Connection (PostgreSQL or SQL Server)
# Format for EF Core: Host=localhost;Port=5434;Database=hackathondb;Username=appuser;Password=apppassword
ConnectionStrings__DefaultConnection=Host=localhost;Port=5434;Database=hackathondb;Username=appuser;Password=apppassword

# Authentication / JWT
Jwt__SecretKey=your-super-secret-key-at-least-32-chars-long
Jwt__Issuer=HackathonApi
Jwt__Audience=HackathonClient
Jwt__ExpiryMinutes=60

# CORS Configuration
Cors__AllowedOrigins=http://localhost:3000,https://your-frontend.vercel.app
