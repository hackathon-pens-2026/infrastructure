# ==========================================
# .NET 10 SignIt Backend Environment Variables
# ==========================================

# ASP.NET Core Settings
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
PORT=8080

# Database Connection (PostgreSQL or SQL Server)
# Format for EF Core: Host=localhost;Port=5434;Database=hackathondb;Username=appuser;Password=apppassword
ConnectionStrings__DefaultConnection=Host=localhost;Port=5434;Database=hackathondb;Username=appuser;Password=apppassword

# Authentication / JWT
# RSA private key, supplied through the server secret store or secrets.env.
# Jwt__PrivateKeyPem="-----BEGIN PRIVATE KEY-----...-----END PRIVATE KEY-----"
Jwt__Issuer=SignIt.Api
Jwt__Audience=SignIt.Bff
Jwt__KeyId=signit-auth-v1
Auth__AccessTokenMinutes=10

# CORS Configuration
# The Next.js /api/backend handler calls the backend server-to-server.
# CORS is only needed if a browser calls the backend directly; arrays use indexed keys.
# Cors__AllowedOrigins__0=https://your-frontend.vercel.app
